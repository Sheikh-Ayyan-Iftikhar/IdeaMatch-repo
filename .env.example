# Gemini API key (https://aistudio.google.com/apikey). Without it, IdeaMatch falls back to keyword search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub token (no scopes needed for public repos). Strongly recommended:
# unauthenticated search is limited to 10 requests/minute, authenticated to 30.
GITHUB_TOKEN=
